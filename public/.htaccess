# 3D Naksha - cPanel Apache Configuration

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical Domain & HTTPS Enforcement (301 Redirect to https://3dnaksha.com/)
  RewriteCond %{HTTP_HOST} ^www\.3dnaksha\.com$ [NC]
  RewriteRule ^(.*)$ https://3dnaksha.com/$1 [L,R=301]

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://3dnaksha.com/$1 [L,R=301]

  # Don't rewrite files or directories that exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other requests to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Browser Caching for Production Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cache-Control Headers for Immutable Hashed Assets and HTML Documents
<IfModule mod_headers.c>
  # HTML documents (never store permanently, must revalidate for pre-rendered route updates)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Immutable hashed JavaScript, CSS, and web fonts (1 year cache)
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Optimized Images (1 month cache)
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
